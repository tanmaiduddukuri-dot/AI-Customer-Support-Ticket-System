# Copy this file to ".env" and fill in your MySQL password.
# createDatabaseIfNotExist=true makes MySQL create the "helpdesk" database for you.
DB_URL=jdbc:mysql://localhost:3306/helpdesk?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_mysql_password
